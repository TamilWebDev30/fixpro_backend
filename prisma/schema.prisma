generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  phone            String?
  passwordHash     String
  role             String           @default("customer") // customer | provider | admin
  status           String           @default("active") // active | pending | blocked
  createdAt        DateTime         @default(now())
  providerProfile  ProviderProfile?
  services         Service[]
  customerBookings Booking[]        @relation("CustomerBookings")
  providerBookings Booking[]        @relation("ProviderBookings")
  reviewsWritten   Review[]         @relation("ReviewsWritten")
  reviewsReceived  Review[]         @relation("ReviewsReceived")
  availability     Availability[]
  address       String?
  notifications Notification[]
  payouts Payout[]
}

model Category {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  icon      String?
  isActive  Boolean           @default(true)
  providers ProviderProfile[]
  services  Service[]
}

model ProviderProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id])
  city            String
  experienceYears Int      @default(0)
  bio             String?
  ratingAvg       Float    @default(0)
}

model Service {
  id          Int       @id @default(autoincrement())
  providerId  Int
  provider    User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  price       Int // rupees
  durationMin Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    User     @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId  Int
  provider    User     @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  scheduledAt DateTime
  address     String
  notes       String?
  total       Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  review  Review?
  payment Payment? // ADD THIS LINE
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId Int
  customer   User     @relation("ReviewsWritten", fields: [customerId], references: [id])
  providerId Int
  provider   User     @relation("ReviewsReceived", fields: [providerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Payment {
  id        Int       @id @default(autoincrement())
  bookingId Int       @unique
  booking   Booking   @relation(fields: [bookingId], references: [id])
  amount    Int
  status    String    @default("created")
  orderId   String    @unique
  txnId     String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

model Availability {
  id         Int     @id @default(autoincrement())
  providerId Int
  provider   User    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  startTime  String // "09:00"
  endTime    String // "18:00"
  isActive   Boolean @default(true)

  @@unique([providerId, dayOfWeek])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Payout {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   User     @relation(fields: [providerId], references: [id])
  amount     Int
  reference  String?
  createdAt  DateTime @default(now())

  @@index([providerId])
}

model Setting {
  key   String @id
  value String
}